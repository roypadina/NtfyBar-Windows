<Project>
  <PropertyGroup>
    <!-- The one version number: exe, zip name and release tag (v<Version>) all come from here. -->
    <Version>0.1.0</Version>
    <Authors>Roy Padina</Authors>
    <Copyright>Copyright (c) 2026 Roy Padina</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Lets the Windows App project build (not run) on macOS/Linux; release builds come from windows-latest CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
